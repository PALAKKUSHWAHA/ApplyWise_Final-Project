# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
RELOAD=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://resumatchfrontend.vercel.app
ENVIRONMENT=development

# LLM Configuration - FREE OPTIONS (No API key required!)
# Choose your LLM provider: "ollama" (RECOMMENDED), "huggingface", "openai", or "anthropic"
LLM_PROVIDER=ollama

# ============================================
# OPTION 1: OLLAMA (Recommended - Easiest Setup)
# ============================================
# 1. Download Ollama from: https://ollama.ai
# 2. Run: ollama pull mistral  (or any model below)
# 3. Start Ollama (it runs on http://localhost:11434 by default)
# Available free models:
#   - mistral (7B, fast, good quality) ⭐ RECOMMENDED
#   - neural-chat (7B, optimized for chat)
#   - llama2 (7B or 13B, powerful)
#   - dolphin-mixtral (8x7B, very capable)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=mistral

# ============================================
# OPTION 2: HUGGING FACE (Local transformer models)
# ============================================
# LLM_PROVIDER=huggingface
# Available models (auto-downloads):
#   - mistralai/Mistral-7B-Instruct-v0.1
#   - meta-llama/Llama-2-7b-chat-hf
#   - tiiuae/falcon-7b-instruct
# Note: Requires GPU/significant RAM
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# ============================================
# OPTION 3: OPENAI (Paid - Only if you provide API key)
# ============================================
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-3.5-turbo

# ============================================
# OPTION 4: ANTHROPIC (Paid - Only if you provide API key)
# ============================================
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-sonnet-20240229

# LLM Parameters
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads
RESULTS_DIR=results

# Database Configuration
DATABASE_URL=sqlite:///resumatch.db
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=resumatch.log

# NLP Models
SENTENCE_MODEL=all-MiniLM-L6-v2
USE_GPU=False

# OCR Configuration
OCR_ENABLED=True
